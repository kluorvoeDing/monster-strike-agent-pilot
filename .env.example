# Path to the iphone-use-mcp binary (auto-discovered if omitted)
IPHONE_USE_MCP_PATH=/Applications/iPhoneUse.app/Contents/MacOS/iphone-use-mcp

# Lease owner identifier to prevent multi-process 409 lock contention
IPHONE_USE_OWNER=ms-agent-pilot

# Screen coordinate reference dimensions (iPhone 16 Pro Max logical frame)
MS_SCREEN_WIDTH=552
MS_SCREEN_HEIGHT=1200
